#!/usr/bin/env zsh
# see: https://github.com/Swiss-Mac-User/macOS-scripted-setup/blob/installer/helpers.sh

# Define variables
# Usage example: echo -e "${RED}Something went wrong!${RESET}"
# -------------------------------------------------------------
SLAY_DIR="$(cd "$(dirname "$0")" && pwd)" # Get full directory name of this script
PARENT_DIR="$(dirname "$SLAY_DIR")"

RESET='\033[0m'
BOLD='\033[1m'
UNDERLINE='\033[4m'
REVERSE='\033[7m'
DIM='\033[2m'
ITALIC='\033[3m' # May not work on all terminals
STRIKETHROUGH='\033[9m'
INDENT='   '

# Foreground colors
BLACK='\033[0;30m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
GRAY='\033[1;30m'
PURPLE="\033[95m"

# Bright colors
BRIGHT_RED='\033[1;31m'
BRIGHT_GREEN='\033[1;32m'
BRIGHT_YELLOW='\033[1;33m'
BRIGHT_BLUE='\033[1;34m'
BRIGHT_MAGENTA='\033[1;35m'
BRIGHT_CYAN='\033[1;36m'
BRIGHT_WHITE='\033[1;97m'

# Background colors
BG_BLACK='\033[40m'
BG_RED='\033[41m'
BG_GREEN='\033[42m'
BG_YELLOW='\033[43m'
BG_BLUE='\033[44m'
BG_MAGENTA='\033[45m'
BG_CYAN='\033[46m'
BG_WHITE='\033[47m'
BG_GRAY='\033[100m'

LINE_SEPARATOR=$BOLD'\n───────────────────────────────────────────────────────────\n'$RESET

# logging
# -------------------------------------------------------------
SLAY_TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')
SLAY_LOG_FILE="$SLAY_DIR/slay.log"

log_message() {
	echo "[${SLAY_TIMESTAMP}] '$1' failed with exit code $2: $3" >> "$SLAY_LOG_FILE"
}

# run commands with spinner & logs
# -------------------------------------------------------------
SPINNER_FRAMES=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")

run_command() {
	local cmd="$*"
	local pid
	local frame=0
	local delay=0.1
	local output_file=$(mktemp)

	tput civis

	# Start command and capture error output
	bash -c "$cmd" > /dev/null 2>"$output_file" &
	pid=$!

	# Spinner animation
	while kill -0 "$pid" 2>/dev/null; do
		printf "\r${BOLD}${INDENT}${INDENT}running:${PURPLE} ${cmd} ${RESET}${SPINNER_FRAMES[frame]}"
		frame=$(( (frame + 1) % ${#SPINNER_FRAMES[@]} ))
		sleep 0.1
	done

	wait "$pid"
	local exit_code=$?

	if [ $exit_code -eq 0 ]; then
		printf "\r${BOLD}${INDENT}${INDENT}running${PURPLE} ${cmd} ${GREEN}success ✔${RESET}\n"
	else
		printf "\r${BOLD}${INDENT}${INDENT}running${PURPLE} ${cmd} ${RED}failed ✘ ${RESET}${DIM}(see slay.log)\n${RESET}"
		local error_msg=$(<"$output_file")
		log_message "$cmd" "$exit_code" "$error_msg"
	fi

	tput cnorm
	rm -f "$output_file"

	return $exit_code
}

# Function to display formatted messages
# -------------------------------------------------------------
print_message() {
	local echout=""
	local message="$1"
	local type="$2"
	local extra_message="$3"  # Second line (optional)

	if [ -n "$type" ]; then
		case "$type" in
			note) echout="${INDENT}$message";;
			confirm) echout="${INDENT}${GREEN}✓  $message${RESET}";;
			muted) echout="${INDENT}${RESET}${DIM}$message${RESET}";;
			error) echout="${INDENT}${BOLD}${RED}✘  $message${RESET}";;
			warning)
				echo -e "${INDENT}${BRIGHT_YELLOW}⚑  $message${RESET}"
				[ -n "$extra_message" ] && echo -e "${INDENT}${BRIGHT_YELLOW}$extra_message${RESET}";;
			success) echout="${INDENT}🎉 ${RESET}$message${RESET}\n";;
			fail) echout="${INDENT}🔥 ${BOLD}${RED}$message${RESET}\n";;
			info) echout="${INDENT}ℹ️  ${RESET}$message${RESET}\n";;
			question) echout="${INDENT}❓ ${RESET}$message${RESET}\n";;
			critical) echout="${INDENT}🚨 ${BG_RED}${WHITE}${BOLD} CRITICAL ERROR: $message ${RESET}\n";;
			sparkles) echout="${INDENT}✨ ${RESET}$message${RESET} ✨\n";;
			command) echout="${INDENT}${INDENT}${BOLD}running ${PURPLE}$message${RESET}";;
			todo) echout="${INDENT}📝 ${YELLOW}${BOLD}TODO:${RESET} $message ${RESET}\n";;
			inform) echout="${RESET}${INDENT}✱  $message${RESET}\n";;
			title) echout="${RESET}${INDENT}✱  ${UNDERLINE}${BOLD}$message${RESET}";;
			step) echout="${RESET}${INDENT}▶︎  ${BOLD}$message${RESET}\n";;
			banner)
				local len=${#message}
				local border=$(printf '━%.0s' $(seq 1 $((len + 4))))  # Create a horizontal line
				echo -e "${INDENT}${BOLD}${BLUE}┏${border}┓${RESET}"
				echo -e "${INDENT}${BOLD}${BLUE}┃  ${WHITE}${message}  ${BLUE}┃${RESET}"
				echo -e "${INDENT}${BOLD}${BLUE}┗${border}┛${RESET}";;
			ask)
				echo -en "${INDENT}❓ ${RESET}$message: "
				read user_response
				# If a variable name is provided, store response in it
				if [ -n "$response_var" ]; then
					eval "$response_var=\"$user_response\""
				fi
				return;;
			yesno)
				while true; do
					echo -en "${INDENT}❓ ${RESET}$message (y/n): "
					read -r user_response
					case "$user_response" in
						[Yy]*) eval "$response_var=true"; break;;
						[Nn]*) eval "$response_var=false"; break;;
						*) eval "$response_var=true"; break;;
					esac
				done
				return;;
			blank) echout="";;
			*) echout="${INDENT}$message";;
		esac
	else
		echout="$message"
	fi
	echo -e "$echout"
}

# Check if a variable is not empty and not whitespace
# -------------------------------------------------------------
check_if_not_empty() {
	if [ -n "$1" ]; then
		# Is NOT empty
		return 0 # true
	else
		# Is empty
		return 1 # false
	fi
}

# Check if a local path exists and is readable
# -------------------------------------------------------------
check_if_file_exists(){
	if [ -r "$1" ]; then
		# Found (and readable)
		return 0 # true
	else
		# Does not exist
		return 1 # false
	fi
}

# Check if Xcode Command Line Tools are installed
# -------------------------------------------------------------
check_if_xcode_installed(){
	local XcodeCLTinstallPath="/Library/Developer/CommandLineTools"
	if [ "$(xcode-select -p)" != "$XcodeCLTinstallPath" ]; then
		# Not installed
		return 1 # false
	else
		# Installed
		return 0 # true
	fi
}

# Check if User has authenticated to App Store
# -------------------------------------------------------------
check_if_app_store_authenticated(){
	if ! command -v mas &> /dev/null; then
		# Not authenticated
		return 1 # false
	else
		# Authenticated
		return 0 # true
	fi
}

# Get logged-in user's Username
# -------------------------------------------------------------
get_username(){
	local whoami="$(id -un)"
	echo whoami
	return 0
}

# Check if current User is in admin group
# Source: https://apple.stackexchange.com/a/179531/86244
# -------------------------------------------------------------
check_if_user_is_admin(){
	if groups $USER | grep -q -w admin; then
		# User is admin
		return 0 # true
	else
		# User is NOT admin
		return 1 # false
	fi
}

# Download a file from a given URL using curl
# -------------------------------------------------------------
download_from_url(){
	if check_if_not_empty "$1" && check_if_not_empty "$2"; then
		local downloadFolder="$HOME/Downloads/"
		local downloadPath="$downloadFolder$2"
		curl -SLf "$1" -o "$downloadPath" -A "macOS-scripted-setup/1.0 (compatible; +https://github.com/Swiss-Mac-User/macOS-scripted-setup)" &>/dev/null
		if [ $? -eq 0 ]; then
			print_message "Downloaded $2 successfully" "confirm"
			print_message "" blank
		else
			print_message "Failed to download $2" "error"
			print_message "" blank
			log_message "download_from_url" "1" "Failed to download $2"
		fi
	else
		print_message "Missing URL or download target path" "error"
		print_message "" blank
		log_message "download_from_url" "1" "Missing URL or download target path"
	fi
}

# Unzip a ZIP-file in place
# -------------------------------------------------------------
unzip_file(){
	local downloadFolder="$HOME/Downloads/"
	local filePath="$downloadFolder$1"
	if check_if_file_exists "$filePath"; then
		unzip -qq "$filePath" -d "$downloadFolder" &>/dev/null
		if [ $? -eq 0 ]; then
			print_message "Unzipped $1 successfully" "confirm"
			print_message "" blank
		else
			print_message "Failed to unzip $1" "error"
			print_message "" blank
			log_message "unzip_file" "1" "Failed to unzip $1"
		fi
	else
		print_message "ZIP file not found: $filePath" "error"
		print_message "" blank
		log_message "unzip_file" "1" "ZIP file not found: $filePath"
	fi
}

# Unmount a DMG-image and copy App to Downloads folder
# -------------------------------------------------------------
unmount_file(){
	local downloadFolder="$HOME/Downloads/"
	local filePath="$downloadFolder$1"
	if check_if_file_exists "$filePath" && check_if_not_empty "$2"; then
		local volumePath="/Volumes/$2"
		hdiutil attach "$filePath" -quiet &>/dev/null
		cp -r "$volumePath/$2.app" "$downloadFolder" &>/dev/null
		hdiutil detach "$volumePath" -force -quiet &>/dev/null
		if [ $? -eq 0 ]; then
			print_message "Unmounted $1 and copied $2 successfully" "confirm"
			print_message "" blank
		else
			print_message "Failed to unmount $1 or copy $2" "error"
			print_message "" blank
			log_message "unmount_file" "1" "Failed to unmount $1 or copy $2"
		fi
	else
		print_message "Missing file path or Application name" "error"
		print_message "" blank
		log_message "unmount_file" "1" "Missing file path or Application name"
		return 1
	fi
}

# Move an Application to the User or System Applications folder
# (and optionally open it upon moving)
# -------------------------------------------------------------
move_application(){
	if check_if_not_empty "$1"; then
		local downloadedApplicationPath="$HOME/Downloads/$1"

		if check_if_file_exists "$downloadedApplicationPath"; then
			if check_if_file_exists "$HOME/Applications/"; then
				local ApplicationsDir="$HOME/Applications/"
			else
				local ApplicationsDir="/Applications/"
			fi

			# Move the Application file
			mv "$downloadedApplicationPath" "$ApplicationsDir" &>/dev/null
			print_message "$1 moved!" "confirm"

			# Open App, if required
			if check_if_not_empty "$2" && [ "$2" = "open" ]; then
				open -gj "$ApplicationsDir$1"
				print_message "$1 opened!" "confirm"
			fi
			print_message "" blank
		else
			print_message "Cannot move Application '$1'\nPath not found: $downloadedApplicationPath" "error"
			log_message "Cannot move Application '$1'\nPath not found: $downloadedApplicationPath"
			print_message "" blank
			return 1 # error
		fi
	else
		print_message "No Application name provided" "error"
		log_message "No Application name provided"
		print_message "" blank
		return 1 # error
	fi
}

# Safely create a new directory
# -------------------------------------------------------------
mkd() {
	if [ -n "$1" ]; then
		if [ -e "$1" ]; then
			if [ ! -d "$1" ]; then
				print_message "$1 - a file with the same name already exists!" error
				log_message "$1 - a file with the same name already exists"
			else
				print_message "✓  $1 already exists. Skipping." muted
			fi
		else
			mkdir -p $1
			print_message "$1 created!" "confirm"
		fi
	fi
}

# return 1 if npm package installed, else 0
# -------------------------------------------------------------
cli_is_installed() {
	# set to 1 initially
	local return_=1
	# set to 0 if not found
	type $1 >/dev/null 2>&1 || { local return_=0; }
	# return value
	echo "$return_"
}

# return 1 if an apt package is installed, else 0
# -------------------------------------------------------------
apt_is_installed() {
	# set to 1 initially
	local return_=1
	# set to 0 if not found
	dpkg -l | grep -qw "$1" || { local return_=0; }
	# return value
	echo "$return_"
}

# return 1 if a brew is installed, else 0
# -------------------------------------------------------------
brew_is_installed() {
	# set to 1 initially
	local return_=1
	# set to 0 if not found
	brew list --formula | grep -qw "$1" || { local return_=0; }
	# return value
	echo "$return_"
}

# return 1 if a cask is installed, else 0
# -------------------------------------------------------------
cask_is_installed() {
	# set to 1 initially
	local return_=1
	# set to 0 if not found
	brew list --cask | grep -qw "$1" || { local return_=0; }
	# return value
	echo "$return_"
}

# return 1 if a mas package is installed, else 0
# -------------------------------------------------------------
mas_is_installed() {
	# set to 1 initially
	local return_=1
	# set to 0 if not found
	mas list | awk '{print $1}' | grep -qw "$1" || { local return_=0; }
	# return value
	echo "$return_"
}

# check & install missing packages
# usage: install_if_missing "wget" "brew_is_installed" "brew install"
# -------------------------------------------------------------
install_if_missing() {
	local package="$1"
	local install_cmd="$2"

	if [[ $("$install_cmd" "$package") -eq 1 ]]; then
		print_message "$package is already installed." "muted"
	else
		eval "$3 $package"
		print_message "$package installed!" "confirm"
	fi
}
